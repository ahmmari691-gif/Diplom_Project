subgraph cluster_roles { label="ACCOUNT roles — access rules, not additional tables"; color="#c4b5a0"; style="rounded,dashed";
Manager [shape=box, style="rounded,filled,dashed", fillcolor="#e9f3ef", label="PLATFORM MANAGER
ACCOUNT.role = manager
name · email · active access
Edits business profiles
Uploads / reviews / activates / deletes documents
Statistics · campaigns · tasks
No customer order contents · no business suspension"];
Administrator [shape=box, style="rounded,filled,dashed", fillcolor="#fff0d7", label="PLATFORM ADMINISTRATOR
ACCOUNT.role = admin
name · email · active account
All manager operations
Suspends / resumes businesses
Invites / revokes managers
Reads platform audit log
No customer order contents"];
}
Manager -> Business [style=dashed, color="#238577", label="edit profile", constraint=false];
Manager -> KnowledgeDocument [style=dashed, color="#238577", label="manage documents", constraint=false];
Administrator -> Business [style=dashed, color="#b77924", label="edit / suspend / resume", constraint=false];
Administrator -> KnowledgeDocument [style=dashed, color="#b77924", label="manage documents", constraint=false];
Administrator -> Invitation [style=dashed, color="#b77924", label="invite manager", constraint=false];
Administrator -> AuditLog [style=dashed, color="#b77924", label="read audit", constraint=false];
Administrator -> Account [style=dashed, color="#b77924", label="revoke manager access", constraint=false];
Legend [shape=box, style="rounded,filled", fillcolor="#f1eee7", label="PK primary key · FK foreign key · UK unique · ? nullable
USER is a guest buyer: no password and no direct business FK
Customer contacts and notes remain encrypted in ORDER
ACCOUNT is an owner/staff login, not a customer
Some scalar fields omitted; full-schema.mmd contains all 21 core tables
Standard Django authentication/session tables omitted"];
}
