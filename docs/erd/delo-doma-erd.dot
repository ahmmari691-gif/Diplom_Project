digraph ERD {
graph [rankdir=LR, bgcolor="#faf8f3", pad=0.5, nodesep=0.6, ranksep=1.1, splines=polyline, fontname="Arial", fontsize=20, labelloc=t, label="DELO DOMA · ERD v4
Guest buyer → Order ← Business
Solid lines: foreign keys · Dashed lines: role permissions (not foreign keys)"];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=10, color="#64748b", fontcolor="#475569", arrowsize=0.8];
Account [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#30375f" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#30375f"><FONT COLOR="white"><B>ACCOUNT</B></FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#64748b" POINT-SIZE="10">core_account</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#64748b">varchar</FONT></TD><TD ALIGN="LEFT">password</TD><TD ALIGN="RIGHT"></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#64748b">boolean</FONT></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="RIGHT"></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#64748b">datetime</FONT></TD><TD ALIGN="LEFT">date_joined</TD><TD ALIGN="RIGHT"></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#64748b">uuid</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="RIGHT">PK</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#64748b">varchar</FONT></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="RIGHT">UK</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#64748b">varchar</FONT></TD><TD ALIGN="LEFT">role</TD><TD ALIGN="RIGHT"></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#64748b">varchar</FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="RIGHT"></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#64748b">boolean</FONT></TD><TD ALIGN="LEFT">platform_active</TD><TD ALIGN="RIGHT"></TD></TR></TABLE>>];
